author": null, "contributor": null}, {"id": "registry_match_specificity_ordering", "label": "Most-specific-key-first ordering", "file_type": "rationale", "source_file": "packages/mock/src/registry/match.ts", "source_location": "L314-331", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three tiebreaks - literal path beats dynamic, more query conditions beat fewer, exact value beats a binding - exist so that registering both of a pair does not make the winner depend on registry object key order, which is invisible in review and changes when someone sorts the table. The order mirrors how the App Router resolves property/search against property/[reference] and how a Next rewrite with a has condition is the narrower rule."}, {"id": "registry_match_loud_key_rejection", "label": "Malformed keys fail loudly", "file_type": "rationale", "source_file": "packages/mock/src/registry/match.ts", "source_location": "L84-96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A key that is silently skipped produces a route that is simply never mocked, and the only symptom is real data arriving where fake data was expected - which reads as the flag not working. Duplicate bindings, empty values and catch-all segments are all rejected at parse time for the same reason; catch-alls additionally cannot be checked against the filesystem, which is the basis of the drift test."}], "edges": [{"source": "registry_match_parsekey", "target": "registry_match_parsequery", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/registry/match.ts", "source_location": "L196", "weight": 1.0}, {"source": "registry_match_parsekey", "target": "registry_match_bindingnames", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/registry/match.ts", "source_location": "L219", "weight": 1.0}, {"source": "registry_match_pars