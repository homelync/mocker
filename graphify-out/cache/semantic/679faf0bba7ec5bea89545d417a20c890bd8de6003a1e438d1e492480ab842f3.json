{"nodes": [{"id": "src_package_boundary_test_extractable_package", "label": "mock/ is extractable as a package", "file_type": "concept", "source_file": "packages/mock/src/package-boundary.test.ts", "source_location": "L5-17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The test travels with the code it constrains, unlike an eslint zone that lives in the host's config and will not move when the folder is lifted out - and a misconfigured rule fails silently. Concretely: no @/ alias, no path that resolves outside mock/, and core/ limited to zod, faker and (in tests) vitest, because the generator is the part with the widest reuse and its dependency list must not grow by accident."}, {"id": "src_package_boundary_test_escapespackage", "label": "escapesPackage", "file_type": "code", "source_file": "packages/mock/src/package-boundary.test.ts", "source_location": "L46-52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_package_boundary_test_sources", "label": "sources (recursive .ts walk)", "file_type": "code", "source_file": "packages/mock/src/package-boundary.test.ts", "source_location": "L25-31", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_package_boundary_test_extractable_package", "target": "src_package_boundary_test_escapespackage", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/package-boundary.test.ts", "source_location": "L39-52", "weight": 1.0}, {"source": "src_package_boundary_test_escapespackage", "target": "src_package_boundary_test_sources", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/package-boundary.test.ts", "source_location": "L54-70", "weight": 1.0}, {"source": "src_package_boundary_test_extractable_package", "target": "registry_serve_second_agnostic_seam", "relatio