{"nodes": [{"id": "src_rewrites_mockrewrites", "label": "mockRewrites", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L193-219", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_torewritesource", "label": "toRewriteSource", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L86-94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_torewritedestination", "label": "toRewriteDestination", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L103-105", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_torewriteconditions", "label": "toRewriteConditions", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L129-143", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_toroutedirectory", "label": "toRouteDirectory", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L153-155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_originalpathname", "label": "originalPathname", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L164-166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_requireapipath", "label": "requireApiPath", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L66-73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_rulesignature", "label": "ruleSignature", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L222-228", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_rewrite", "label": "Rewrite", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L52-56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_rewritehas", "label": "RewriteHas", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L38-42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_mock_endpoint_prefix", "label": "MOCK_ENDPOINT_PREFIX", "file_type": "code", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_rewrites_config_time_absence", "label": "Config-time emptiness in production", "file_type": "rationale", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L168-194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mockRewrites runs in plain Node at config time, before any bundling, and `next build` runs with NODE_ENV=production - so it returns an empty list and a production build contains no path to the mock endpoint at all: the feature is absent by construction rather than disabled by a runtime flag. Rewrites are beforeFiles so a registered route is intercepted before its route.ts is matched (afterFiles would never fire for a route that exists), one rule per unique path AND condition set since rewrites cannot match a method, emitted most-constrained-first because Next takes the first matching rule."}, {"id": "src_rewrites_next_dialect_boundary", "label": "Next dialect stays in the adapter", "file_type": "rationale", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L10-73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A registry key is written the way the filesystem reads; Next wants :param in a source, a destination under the catch-all, and a directory under src/app/api for the drift test - all facts about the App Router, so none belong in mock/registry. The module imports registry/match directly rather than the barrel, because the index pulls in serve.ts and through it core and faker, and next.config.ts must stay cheap to evaluate. requireApiPath enforces the /api convention the destination algebra depends on, which the runtime-agnostic registry deliberately does not."}, {"id": "src_rewrites_presence_not_capture", "label": "Bindings become presence conditions", "file_type": "rationale", "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L107-143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next preserves the query string across a rewrite and serveFromRegistry re-matches the key at the destination, so asking Next to capture a binding would be a second, weaker copy of matching already done properly downstream. The gap is ?ref= (present but empty), which satisfies presence and is then rejected by matchQuery - an explicit 404 rather than a fall-through, the right trade since a page about the empty string is the failure nobody would look for. Exact values are regex-escaped because Next compiles `value` to a regex and an unescaped dot would match any character."}], "edges": [{"source": "registry_match_path_query_split", "target": "src_rewrites_torewritesource", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L75-85", "weight": 1.0}, {"source": "src_rewrites_originalpathname", "target": "src_rewrites_torewritedestination", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/next-adapter/src/rewrites.ts", "source_location": "L96-166", "weight": 1.0}, {"source": "src_