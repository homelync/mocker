e worth spotting in a scrolling dev log."}], "edges": [{"source": "src_log_logmock", "target": "src_log_formatmocklog", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L90", "weight": 1.0}, {"source": "src_log_logmock", "target": "src_log_ismocklogenabled", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L88", "weight": 1.0}, {"source": "src_log_ismocklogenabled", "target": "src_log_environment", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L44", "weight": 1.0}, {"source": "src_log_logmock", "target": "src_log_mocklogentry", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L87", "weight": 1.0}, {"source": "src_log_formatmocklog", "target": "src_log_mocklogentry", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L73", "weight": 1.0}, {"source": "src_log_visible_mock_principle", "target": "src_log_logmock", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L1-14", "weight": 1.0}, {"source": "src_log_environment", "target": "src_flag_environment", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "packages/mock/src/log.ts", "source_location": "L25-33", "weight": 1.0}, {"source": "src_log_visible_mock_principle", "target": "src_flag_single_flag_semantics", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/mock/src/log.ts", "source_location": "L4-8", "weight": 1.0}], "hyperedges": []}