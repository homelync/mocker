{
  "name": "@magicspon/storybook-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "CSF factories import the preview as `#.storybook/preview`; this subpath map is what resolves it.",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@magicspon/mocker": "workspace:*",
    "@magicspon/mocker-storybook": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "storybook": "^10.5.9",
    "typescript": "^7",
    "vite": "^8.2.1"
  }
}
