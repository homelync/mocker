{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Every published entry point. Anything not reachable from one of these is
  // genuinely dead — which is the question worth asking in a library repo.
  "entry": [
    "packages/mocker/src/index.ts",
    "packages/mocker/src/core/index.ts",
    "packages/mocker/src/config.ts",
    "packages/mocker-next/src/index.ts",
    "packages/mocker-next/src/config.ts",
    "packages/mocker-next/src/index.prod.ts",
    "scripts/renovate-changeset.mjs"
  ],

  "ignorePatterns": [
    "**/.next/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/snap/**",
    "**/vite.config.*.timestamp-*.*",
    "graphify-out/**"
  ],

  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste worth refactoring.
    // The two package-boundary tests are a deliberate pair: each must travel
    // with the package it constrains.
    "minOccurrences": 3
  },

  "rules": {
    "unused-dependencies": "warn"
  }
}
