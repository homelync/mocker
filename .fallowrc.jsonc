{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Fallow already finds each package's published entry points (`exports` and
  // `bin`) from its package.json. This lists only what no package.json names.
  "entry": ["scripts/renovate-changeset.mjs"],

  // Read by a tool rather than imported by anything. `commitlint.config.js` has
  // a fallow plugin that knows to look for it; nano-staged does not, so without
  // this line the pre-commit config reads as a dead file.
  "dynamicallyLoaded": ["nano-staged.js"],

  "ignorePatterns": [
    "**/.next/**",
    // Written by `msw init`, not by us. Every finding in it is a report about
    // MSW's code that nobody here may act on.
    "**/mockServiceWorker.js",
    "graphify-out/**"
  ],

  "duplicates": {
    // Hide small-N clones; focus on widespread copy-paste worth refactoring.
    "minOccurrences": 4,

    // The five package-boundary tests share an import-graph walker on purpose:
    // each must travel with the package it constrains, and a shared helper would
    // be exactly the repo-level thing that did not survive the last extraction.
    // Reported as duplication, that decision reads as an oversight every time.
    "ignore": ["**/package-boundary.test.ts"]
  },

  "rules": {
    "unused-dependencies": "warn"
  }
}
