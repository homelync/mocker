{
  "name": "@homelync/mocker",
  "version": "1.0.0",
  "description": "Generate fake data from zod schemas and serve it over HTTP",
  "keywords": [
    "zod",
    "mock",
    "faker",
    "fixtures",
    "test-data",
    "msw"
  ],
  "license": "MIT",
  "author": "homelync",
  "homepage": "https://github.com/homelync/mocker/tree/main/packages/mocker#readme",
  "bugs": "https://github.com/homelync/mocker/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homelync/mocker.git",
    "directory": "packages/mocker"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.19.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./config": "./src/config.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
